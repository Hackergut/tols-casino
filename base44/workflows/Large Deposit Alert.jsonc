{
  "name": "Large Deposit Alert",
  "description": "Notifies the admin team by email when a confirmed deposit exceeds the configured threshold (PlatformSetting: large_deposit_threshold).",
  "trigger": {
    "condition": "${ .trigger.data.status == \"confirmed\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Deposit"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "large_deposit_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyLargeDeposit",
            "args": {
              "deposit_id": "${ .trigger.entity_id }",
              "internal_token": "b44i_7f3e9c2a51d84b6f8e0a4c7d92135f6e_zQ8kXw41"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Avvisa team deposito grande",
            "description": "Email agli admin se supera la soglia"
          }
        }
      }
    ]
  }
}
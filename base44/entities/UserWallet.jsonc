{
  "name": "UserWallet",
  "type": "object",
  "properties": {
    "balance": {
      "type": "number",
      "default": 1000
    },
    "currency": {
      "type": "string",
      "default": "USDT"
    },
    "vip_level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "total_wagered": {
      "type": "number",
      "default": 0
    },
    "deposit_addresses": {
      "type": "string",
      "default": "",
      "description": "JSON map chain -> per-user HD-derived custodial deposit address { ethereum, polygon, solana }"
    },
    "deposit_index": {
      "type": "number",
      "default": 0,
      "description": "HD derivation index assigned to this user (unique per user)"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
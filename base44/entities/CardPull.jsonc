{
  "name": "CardPull",
  "type": "object",
  "properties": {
    "collection": {
      "type": "string",
      "description": "Collection / brand (e.g. Pok\u00e9mon, NBA, FIFA, UFC, F1, Yu-Gi-Oh!)"
    },
    "card_name": {
      "type": "string"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary",
        "mythic"
      ],
      "default": "common"
    },
    "pack_name": {
      "type": "string",
      "default": ""
    },
    "puller": {
      "type": "string",
      "default": "",
      "description": "Alias of the user who pulled the card"
    },
    "image": {
      "type": "string",
      "default": "",
      "description": "Optional card art URL"
    }
  },
  "required": [
    "collection",
    "card_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
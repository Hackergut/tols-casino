{
  "name": "SlotGame",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Slug univoco usato nell'URL"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "default": ""
    },
    "rtp": {
      "type": "number",
      "default": 0
    },
    "volatility": {
      "type": "string",
      "default": ""
    },
    "external_id": {
      "type": "string",
      "default": "",
      "description": "ID gioco nell'aggregatore (popolato dalla sync)"
    },
    "has_demo": {
      "type": "boolean",
      "default": true
    },
    "has_real": {
      "type": "boolean",
      "default": false
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "demo_url": {
      "type": "string",
      "default": "",
      "description": "Demo play URL (from iGaming.tools) \u2014 launched in an iframe"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "slug",
    "name",
    "provider"
  ]
}
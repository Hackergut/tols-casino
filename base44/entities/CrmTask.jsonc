{
  "name": "CrmTask",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string", "default": "", "maxLength": 4000 },
    "status": { "type": "string", "default": "todo", "enum": ["todo", "in_progress", "blocked", "done", "cancelled"] },
    "priority": { "type": "string", "default": "medium", "enum": ["low", "medium", "high", "urgent"] },
    "assignee_id": { "type": "string", "default": "" },
    "reporter_id": { "type": "string", "default": "" },
    "due_date": { "type": "string", "format": "date-time" },
    "tags": { "type": "string", "default": "" },
    "mentions": { "type": "string", "default": "" },
    "order": { "type": "number", "default": 0 },
    "description_note": { "type": "string", "default": "", "maxLength": 1000 }
  },
  "required": ["title"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}

{
  "name": "PlatformSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique setting key"
    },
    "value": {
      "type": "string",
      "default": ""
    },
    "category": {
      "type": "string",
      "default": "general"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "key",
    "value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
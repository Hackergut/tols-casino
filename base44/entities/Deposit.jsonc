{
  "name": "Deposit",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "enum": [
        "solana",
        "ethereum",
        "polygon"
      ]
    },
    "tx_hash": {
      "type": "string",
      "description": "Prefixed chain:hash dedupe key"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Credited amount in USDT"
    },
    "currency": {
      "type": "string",
      "default": "USDT"
    },
    "from_address": {
      "type": "string",
      "default": ""
    },
    "to_address": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "failed"
      ],
      "default": "pending"
    },
    "credited": {
      "type": "boolean",
      "default": false
    },
    "referral_code": {
      "type": "string",
      "default": "",
      "description": "Affiliate referral code that referred this depositor (empty if none). Set at deposit time; drives the affiliate-commission workflow."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "chain",
    "tx_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
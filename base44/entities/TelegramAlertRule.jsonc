{
  "name": "TelegramAlertRule",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "enabled": { "type": "boolean", "default": true },
    "event_type": { "type": "string", "enum": ["registration", "login", "deposit", "withdrawal", "deposit_pending", "big_win", "system"] },
    "condition": { "type": "string", "default": "" },
    "telegram_chat_id": { "type": "string" },
    "telegram_thread_id": { "type": "string", "default": "" },
    "message_template": { "type": "string", "default": "", "maxLength": 4000 },
    "cooldown_minutes": { "type": "number", "default": 5 },
    "last_triggered_at": { "type": "string", "format": "date-time" }
  },
  "required": ["name", "event_type", "telegram_chat_id"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}

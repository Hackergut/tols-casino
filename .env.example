# ── TOLS Casino — Professional Full-Stack Env ──
# Copy to .env.local for local dev, or set in Vercel / Docker

# API — Professional Express backend (no Base44)
# Local: http://localhost:3001/api — Prod: https://api.tols.com/api
VITE_API_BASE=/api
VITE_DEMO_FALLBACK=false

# Database — for server/ or production/ Prisma
DATABASE_URL=postgresql://user:pass@host:5432/tols?sslmode=require
# or SQLite dev: file:./db/custom.db

# Auth — JWT secret for server
JWT_SECRET=change-me-to-64-random-chars

# Payments — public deposit addresses (no private keys)
# Set via Admin API after deploy: PUT /api/platform-setting
# Supported: btc, eth, usdt_erc20, solana, polygon

# Telegram — optional monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Legacy Base44 — deprecated, kept for migration only (remove in prod)
# VITE_BASE44_APP_ID=
# VITE_BASE44_APP_BASE_URL=
